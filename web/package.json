{
  "name": "mario-bench-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --webpack --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit --incremental false",
    "prebuild": "npm run prepare-assets",
    "predev": "npm run prepare-assets",
    "prepare-assets": "node scripts/prepare-game.mjs && node scripts/prepare-data.mjs",
    "check:ui": "node scripts/check-ui.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "geist": "^1.9.0",
    "jsnes": "^2.1.0",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
